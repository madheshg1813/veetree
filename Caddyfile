{
	# Railway terminates TLS at its edge, so Caddy serves plain HTTP internally.
	auto_https off
	admin off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

# Railway injects PORT; 8080 is the local fallback.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# Fingerprint-free assets: cache hard, they change by filename edit only.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"

	# Always revalidate the page itself so edits go live immediately.
	@html path / /index.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Single-page site: anything unknown falls back to the homepage.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /index.html
			file_server
		}
	}
}
