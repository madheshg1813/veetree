# ── Cloudinary ────────────────────────────────────────────────────────────
# The cloud name is public — it appears in every image URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=z4e833jz
NEXT_PUBLIC_CLOUDINARY_FOLDER=veetree

# ── Upload script only — NEVER commit real values ─────────────────────────
# Used by `npm run images:upload`. Not referenced by the app at runtime,
# so this secret never reaches the browser or a deployed build.
# Copy this file to .env.local and paste your own credentials there.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@z4e833jz

# ── Mobile OTP verification at checkout (2Factor.in) ──────────────────────
# SERVER-ONLY. No NEXT_PUBLIC_ prefix on either of these: the API key spends
# real SMS credit, so it must never reach the browser.
#
# Get the key from https://2factor.in → Dashboard → API Key. Leave both blank
# and checkout simply skips the verification step — nothing breaks.
TWOFACTOR_API_KEY=
# Signs the proof that a number was verified. Generate with:
#   openssl rand -hex 32
OTP_SIGNING_SECRET=
# Optional: your own DLT-registered template name, once TRAI registration is
# done. Unset means 2Factor sends on its own registered template.
TWOFACTOR_TEMPLATE_NAME=

# Optional tuning — the defaults are sized for a small prepaid balance.
# OTP_CODE_TTL=600           # seconds a code stays valid
# OTP_PROOF_TTL=1800         # seconds a verification stays good for
# OTP_RESEND_COOLDOWN=45     # seconds between resends to one number
# OTP_MAX_ATTEMPTS=5         # wrong codes allowed per challenge
# OTP_PER_PHONE_WINDOW=3     # sends per number per 15 minutes
# OTP_PER_PHONE_DAY=6        # sends per number per day
# OTP_PER_IP_HOUR=8          # sends per IP per hour
# OTP_DAILY_CAP=100          # hard ceiling on sends per day, site-wide
# What checkout PROMISES about how the code arrives: sms | call | auto.
# This does not change the API request — 2Factor picks the channel — it only
# keeps the page honest. Set to "sms" once DLT registration is complete.
OTP_DELIVERY_CHANNEL=auto

# ── Customer accounts: email verification (Resend) ─────────────────────────
# Signup sends a one-time code to the customer's inbox; without a key the
# signup route returns 503 and no account can be created.
# resend.com → API Keys → Create (Sending access, veetree.life)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or delivery is rejected.
# Defaults to "Veetree <no-reply@veetree.life>" when unset.
# EMAIL_FROM=Veetree <no-reply@veetree.life>

# ── Razorpay ───────────────────────────────────────────────────────────────
# Key id is public (identifies the account to Checkout); the secret verifies
# the payment signature server-side and must never reach the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where product reviews are emailed. Defaults to veetreework@gmail.com.
# REVIEWS_TO=veetreework@gmail.com
